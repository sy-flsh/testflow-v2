generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  PENDING
}

// c3: 기능명세서 v2 Role 6단 / Scope 기반 권한 모델 준비용 enum.
// 아직 어떤 모델/필드에도 연결하지 않으며, 런타임 권한 검증(guards/buildPermissions)에도
// 사용하지 않는다. 실제 사용처(UserRole 모델)는 c4, guards 전환은 c5에서 처리한다.
// 기존 MemberRole(ADMIN/MEMBER/VIEWER)과 병존한다.
enum Role {
  MASTER
  CO
  WO
  PO
  MEMBER
  VIEWER
}

enum ScopeType {
  COMPANY
  WORKSPACE
  PROJECT
}

// c8-1: Company 사용자 초대 상태.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// c9-1: Company 단위 사용자 활성/비활성 상태(전역 User.isActive 가 아니라 Company 단위).
enum CompanyUserStatus {
  ACTIVE
  INACTIVE
}

// c9-6: 보안 감사 이벤트 종류(서버 내부 고정 집합 → enum).
// c10-1: 전역 계정 lifecycle 이벤트(USER_SOFT_DELETED/USER_RESTORED) 추가.
// c10-8: MasterAdmin 권한 위임/해제 이벤트(MASTER_ADMIN_GRANTED/REVOKED) 추가.
// 이 lifecycle/admin 이벤트는 companyId = null 인 global event 로 기록한다(특정 Company 범위 아님).
enum SecurityAuditEventType {
  COMPANY_USER_DEACTIVATED
  COMPANY_USER_REACTIVATED
  INACTIVE_COMPANY_ACCESS_DENIED
  USER_SOFT_DELETED
  USER_RESTORED
  MASTER_ADMIN_GRANTED
  MASTER_ADMIN_REVOKED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TestCaseStatus {
  READY
  DRAFT
  DEPRECATED
}

enum RunStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum ResultStatus {
  PENDING
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DefectSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum AiDraftStatus {
  DRAFT
  SAVED
  FAILED
  FALLBACK
}

model Company {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  isActive    Boolean            @default(true)
  // c1: 상위 테넌트 모델만 도입. ownerUserId는 nullable 스칼라로 두고,
  // User-Company relation 연결은 c4(User.companyId 도입)에서 함께 처리한다.
  ownerUserId String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspaces  Workspace[]
  invitations Invitation[]
  userStates  CompanyUserState[]

  @@map("companies")
}

model MasterAdmin {
  id           String   @id @default(cuid())
  // c10-7: MasterAdmin identity 는 **User.id 로 고정**한다(권한 판정의 단일 기준).
  // userId 는 처음엔 nullable + 1:1 backfill(email→userId, 안전 매칭만). userId null/연결 User 없음은
  // fail-closed(권한 미인정). onDelete Restrict 로 연결 User 의 물리 삭제를 막아 binding 을 보존한다
  // (soft delete 는 row 를 지우지 않으므로 영향 없음). MasterAdmin row 는 물리 삭제하지 않는 정책 유지.
  userId       String?  @unique
  user         User?    @relation("UserMasterAdmin", fields: [userId], references: [id], onDelete: Restrict)
  // legacy(인증 source of truth 아님 — c10-7 이후 email/passwordHash 는 권한 판정에 사용하지 않는다).
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("master_admins")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  avatarUrl       String?
  // c10-1: 전역 계정 탈퇴(soft delete). deletedAt != null 이면 탈퇴 계정이다.
  // 물리 삭제가 아니라 row 를 보존하므로 기존 FK cascade 는 발생하지 않는다.
  // email/name 은 유지(unique 보존, 감사/historical 표시용). 마스킹은 표시 계층에서 처리.
  // deletedByUserId 는 relation 없는 nullable scalar(self=본인 id, 향후 MasterAdmin 강제삭제 대비).
  // deletionReason 은 코드 상수(SELF_WITHDRAWAL 등)만 저장한다(자유 텍스트 미저장).
  deletedAt       DateTime?
  deletedByUserId String?
  deletionReason  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         WorkspaceMember[]
  sessions        Session[]
  roles           UserRole[]
  sentInvitations Invitation[]       @relation("InvitationInvitedBy")
  companyStates   CompanyUserState[] @relation("CompanyUserStateSubject")
  // c10-7: 이 User 에 연결된 MasterAdmin(있으면). 1:1(MasterAdmin.userId @unique).
  masterAdmin     MasterAdmin?       @relation("UserMasterAdmin")

  @@index([deletedAt])
  @@map("users")
}

model Workspace {
  id               String            @id @default(cuid())
  // c2: Company 연결(expand). 기존 signup 경로가 company 없이 Workspace를 생성하므로
  // 이 단계에서는 nullable 로 둔다. seed/기존 데이터는 backfill 로 기본 Company에 연결.
  // NOT NULL 강제 + Company-aware signup 전환은 인증 단계(c5)에서 처리.
  companyId        String?
  name             String
  slug             String            @unique
  description      String            @default("")
  logoUrl          String?
  timezone         String            @default("Asia/Seoul")
  // c2: 워크스페이스 소유자. relation 미연결 nullable 스칼라(User 무변경).
  // Role 기반 소유자 검증은 c4/c5에서 처리.
  ownerUserId      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members          WorkspaceMember[]
  projects         Project[]
  selectedSessions Session[]         @relation("SelectedWorkspaceSession")

  @@index([companyId])
  @@map("workspaces")
}

model Session {
  id                     String     @id @default(cuid())
  userId                 String
  tokenHash              String     @unique
  selectedWorkspaceId    String?
  expiresAt              DateTime
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastSeenAt             DateTime?
  // c10-5: MasterAdmin step-up 재인증 시각(현재 Session 한정). null=미인증.
  // not null 이면 adminReauthenticatedAt + 15분 동안만 admin elevation 유효(guard 가 현재 시각과 비교).
  // 자동 연장/다른 Session 전파 없음. logout/session 삭제 시 함께 사라진다.
  adminReauthenticatedAt DateTime?
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedWorkspace      Workspace? @relation("SelectedWorkspaceSession", fields: [selectedWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  key         String
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

// c4: 기능명세서 v2 (User × Scope) 다중 Role 모델(라디오: scope 1건당 단일 Role).
// scopeId 는 scopeType 에 따라 company/workspace/project id 를 가리키는 polymorphic 값이라
// FK relation 을 두지 않는다. scope-role 정합성(예: CO=COMPANY 만)은 DB CHECK 없이
// 애플리케이션 레벨에서 검증할 예정(c5). 현재는 어떤 guard/auth 도 이 모델을 참조하지 않으며,
// 기존 WorkspaceMember.role 과 병존한다.
model UserRole {
  id        String    @id @default(cuid())
  userId    String
  scopeType ScopeType
  scopeId   String
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([role])
  @@map("user_roles")
}

// c8-1: Company CO 가 미가입 사용자를 초대하기 위한 1회용 토큰 초대.
// raw token 은 저장하지 않고 SHA-256 tokenHash 만 보관한다(생성 응답에서만 inviteUrl 1회 노출).
// 초대 수락/회원가입 연결은 c8-2 범위.
model Invitation {
  id              String           @id @default(cuid())
  companyId       String
  email           String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  roles           InvitationRole[]

  @@index([companyId, email])
  @@index([status, expiresAt])
  @@map("invitations")
}

// c8-1: 초대 발급 시점의 (Scope × Role) snapshot. 수락 시 UserRole 로 승격(c8-2).
model InvitationRole {
  id           String     @id @default(cuid())
  invitationId String
  scopeType    ScopeType
  scopeId      String
  role         Role
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("invitation_roles")
}

// c9-1: Company 단위 사용자 활성/비활성 상태.
// 한 User 는 여러 Company 에 속할 수 있으므로 상태는 (companyId, userId) 단위로 둔다.
// 비활성화는 UserRole/WorkspaceMember 를 삭제하지 않고 이 레코드의 status 만 INACTIVE 로 바꾼다.
// deactivatedBy/reactivatedBy 는 ownerUserId 와 동일하게 relation 없는 scalar 로 둔다(감사용).
model CompanyUserState {
  id                  String            @id @default(cuid())
  companyId           String
  userId              String
  status              CompanyUserStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  reactivatedAt       DateTime?
  reactivatedByUserId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User              @relation("CompanyUserStateSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@map("company_user_states")
}

// c9-6: 영속 보안 감사 이벤트.
// actor/target/company 는 **relation 없는 scalar ID** 로 보관한다 — 감사 로그는 User/Company
// 삭제 후에도 보존되어야 하므로 FK cascade 로 흔적이 사라지면 안 된다.
// 민감정보(token/password/cookie/inviteUrl/body/IP 원문 등)는 저장하지 않는다.
model SecurityAuditEvent {
  id           String                 @id @default(cuid())
  eventType    SecurityAuditEventType
  occurredAt   DateTime               @default(now())
  actorUserId  String?
  targetUserId String?
  companyId    String?
  guardName    String?
  metadata     Json?

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([companyId, occurredAt])
  @@index([targetUserId, occurredAt])
  @@map("security_audit_events")
}

// c9-6: 반복 access-denied 이벤트의 DB 기반 분산 throttle.
// throttleKey 유니크 + Postgres ON CONFLICT 조건부 update 로 다중 인스턴스 경쟁에서도
// window 당 1건만 SecurityAuditEvent 를 저장하도록 보장한다.
model SecurityAuditThrottle {
  id            String                 @id @default(cuid())
  throttleKey   String                 @unique
  eventType     SecurityAuditEventType
  targetUserId  String?
  companyId     String?
  lastEmittedAt DateTime
  expiresAt     DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([expiresAt])
  @@index([eventType, targetUserId, companyId])
  @@map("security_audit_throttles")
}

model Project {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String            @default("")
  color       String            @default("#2563EB")
  status      ProjectStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testFolders TestFolder[]
  testCases   TestCase[]
  testRuns    TestRun[]
  defects     Defect[]
  aiDrafts    AiTestCaseDraft[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([updatedAt])
  @@map("projects")
}

model TestFolder {
  id        String       @id @default(cuid())
  projectId String
  parentId  String?
  slug      String
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    TestFolder?  @relation("TestFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  TestFolder[] @relation("TestFolderTree")
  testCases TestCase[]

  @@unique([projectId, slug])
  @@index([projectId, parentId])
  @@index([projectId, deletedAt])
  @@map("test_folders")
}

model TestCase {
  id             String          @id @default(cuid())
  projectId      String
  folderId       String
  code           String
  title          String
  priority       Priority        @default(MEDIUM)
  status         TestCaseStatus  @default(DRAFT)
  tags           String[]        @default([])
  authorName     String          @default("김QA")
  description    String          @default("")
  preconditions  String          @default("")
  expectedResult String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder         TestFolder      @relation(fields: [folderId], references: [id], onDelete: Restrict)
  steps          TestStep[]
  runResults     TestRunResult[]
  defectLinks    DefectLink[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([projectId, folderId])
  @@index([projectId, deletedAt])
  @@map("test_cases")
}

model TestStep {
  id             String   @id @default(cuid())
  testCaseId     String
  order          Int
  action         String
  expectedResult String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, order])
  @@index([testCaseId])
  @@map("test_steps")
}

model TestRun {
  id           String          @id @default(cuid())
  projectId    String
  slug         String
  title        String
  description  String          @default("")
  assigneeName String          @default("김QA")
  environment  String          @default("QA Server")
  startDate    DateTime
  dueDate      DateTime
  status       RunStatus       @default(PLANNED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results      TestRunResult[]

  @@unique([projectId, slug])
  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@map("test_runs")
}

model TestRunResult {
  id           String       @id @default(cuid())
  runId        String
  testCaseId   String
  code         String
  status       ResultStatus @default(PENDING)
  actualResult String       @default("")
  defectCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  run          TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase     TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  defectLinks  DefectLink[]

  @@unique([runId, testCaseId])
  @@unique([runId, code])
  @@index([testCaseId])
  @@index([runId, status])
  @@map("test_run_results")
}

model Defect {
  id                String         @id @default(cuid())
  projectId         String
  code              String
  title             String
  description       String         @default("")
  reproductionSteps String         @default("")
  checklist         String[]       @default([])
  severity          DefectSeverity @default(MAJOR)
  priority          Priority       @default(MEDIUM)
  status            DefectStatus   @default(OPEN)
  assigneeName      String         @default("미지정")
  reporterName      String         @default("김QA")
  attachmentCount   Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links             DefectLink[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, deletedAt])
  @@map("defects")
}

model DefectLink {
  id              String         @id @default(cuid())
  defectId        String
  testCaseId      String?
  testRunResultId String?
  createdAt       DateTime       @default(now())
  defect          Defect         @relation(fields: [defectId], references: [id], onDelete: Cascade)
  testCase        TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRunResult   TestRunResult? @relation(fields: [testRunResultId], references: [id], onDelete: Cascade)

  @@unique([defectId, testCaseId])
  @@unique([defectId, testRunResultId])
  @@index([testCaseId])
  @@index([testRunResultId])
  @@map("defect_links")
}

model AiTestCaseDraft {
  id           String        @id @default(cuid())
  projectId    String
  prompt       Json
  source       String        @default("fallback")
  status       AiDraftStatus @default(DRAFT)
  items        Json
  errorMessage String?
  createdById  String?
  createdAt    DateTime      @default(now())
  savedAt      DateTime?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([createdAt])
  @@map("ai_test_case_drafts")
}
